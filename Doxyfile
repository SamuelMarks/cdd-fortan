PROJECT_NAME           = "cdd-fortran"
PROJECT_NUMBER         = "0.1.0"
PROJECT_BRIEF          = "Bidirectional JSON <-> Fortran UDT SDK & CLI (FORTRAN I through Fortran 2023)"
OUTPUT_DIRECTORY       = build/docs
OPTIMIZE_FOR_FORTRAN   = YES
EXTENSION_MAPPING      = f90=FortranFree f=FortranFixed for=FortranFixed
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
INPUT                  = src app test
FILE_PATTERNS          = *.f90 *.f *.for
RECURSIVE              = YES
QUIET                  = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO
