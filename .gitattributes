*.mod    binary
*.smod   binary
*.mod0   binary
*.rmod   binary
*.o      binary
*.obj    binary
*.a      binary
*.lib    binary
*.so     binary
*.dylib  binary
*.dll    binary
*.exe    binary
*.out    binary
*.pdb    binary

# Coverage & profiling binary files
*.gcno     binary
*.gcda     binary
*.profraw  binary
*.profdata binary

# Compressed archives & packages
*.tar  binary
*.gz   binary
*.tgz  binary
*.xz   binary
*.txz  binary
*.bz2  binary
*.tbz2 binary
*.zst  binary
*.zip  binary
*.7z   binary
*.whl  binary
*.deb  binary
*.rpm  binary
*.dmg  binary
*.pkg  binary
*.msi  binary

# Images, documents & fonts
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.bmp   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary

# Binary scientific / unformatted Fortran data files
*.nc   binary
*.hdf  binary
*.h5   binary
*.hdf5 binary
*.bin  binary
*.dat  binary
*.uf   binary

# ------------------------------------------------------------------------------
# `git archive` Export Exclusions (Clean GitHub Release Source Tarballs)
# Preserves `src/`, `app/`, `test/`, `CMakeLists.txt`, `fpm.toml`, and `Doxyfile`
# so downstream `fpm`, CMake, Spack, Conda, and Homebrew builds work out-of-box.
# ------------------------------------------------------------------------------
.github/                       export-ignore
.pre-commit-config.yaml        export-ignore
.editorconfig                  export-ignore
.gitattributes                 export-ignore
.gitignore                     export-ignore
TODO_PLAN.md                   export-ignore
scripts/install_no_push_hook.sh export-ignore
