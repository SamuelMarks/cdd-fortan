# ==============================================================================
# cdd-fortran — Root .editorconfig
# https://editorconfig.org
# ==============================================================================

root = true

# ------------------------------------------------------------------------------
# Global Defaults
# ------------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2

# ------------------------------------------------------------------------------
# Modern Free-Form Fortran (Fortran 90 / 95 / 2003 / 2008 / 2018 / 2023)
# & Preprocessed / Include Sources
# ------------------------------------------------------------------------------
[*.{f90,F90,f95,F95,f03,F03,f08,F08,f18,F18,f23,F23,fpp,FPP,fypp,inc,fh}]
indent_style = space
indent_size = 2
max_line_length = 140

[{src,app}/**.{f90,F90,f95,F95,f03,F03,f08,F08,f18,F18,f23,F23}]
max_line_length = 132

# ------------------------------------------------------------------------------
# Legacy Fixed-Form FORTRAN (FORTRAN I / II / III / IV / 66 / 77)
# Columns 1-5: statement label, Column 6: continuation, Columns 7-72: statement,
# Columns 73-80: optional card sequence ID (trailing spaces must be preserved).
# ------------------------------------------------------------------------------
[*.{f,F,for,FOR,ftn,FTN,f66,F66,f77,F77}]
indent_style = space
indent_size = 6
max_line_length = 72
trim_trailing_whitespace = false

# ------------------------------------------------------------------------------
# Build Systems & Package Manifests (CMake, fpm, Make, Doxygen)
# ------------------------------------------------------------------------------
[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.toml]
indent_style = space
indent_size = 2

[{Doxyfile,*.dox}]
indent_style = space
indent_size = 2
max_line_length = 120

[{Makefile,GNUmakefile,makefile,*.mk}]
indent_style = tab
indent_size = 4
tab_width = 4

# ------------------------------------------------------------------------------
# Scripting & Automation (Python, POSIX Shell, Windows Batch/PowerShell)
# ------------------------------------------------------------------------------
[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 2

# ------------------------------------------------------------------------------
# C / C++ Interop (`ISO_C_BINDING`)
# ------------------------------------------------------------------------------
[*.{c,h,cpp,hpp}]
indent_style = space
indent_size = 2
max_line_length = 120

# ------------------------------------------------------------------------------
# Structured Data, Schemas, CI Workflows & Web Assets
# ------------------------------------------------------------------------------
[*.{json,jsonl}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 140

[*.{xml,xsd,svg,html,css}]
indent_style = space
indent_size = 2

# ------------------------------------------------------------------------------
# Documentation & Prose
# Preserve two-space hard line breaks in Markdown; disable line-length cap.
# ------------------------------------------------------------------------------
[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

[*.{rst,adoc,txt}]
indent_style = space
indent_size = 2
max_line_length = off

# ------------------------------------------------------------------------------
# Git, Editor & License Metadata
# ------------------------------------------------------------------------------
[{.gitignore,.gitattributes,.editorconfig,LICENSE*,NOTICE*,CITATION.cff}]
indent_style = space
indent_size = 2
