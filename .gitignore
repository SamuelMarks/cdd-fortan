# ==============================================================================
# cdd-fortran — Root .gitignore
# Covers Fortran (FORTRAN I .. Fortran 2023), CMake, Ninja, CTest, fpm, Doxygen,
# gcov/lcov/llvm-cov, Python helper tooling, IDEs, OS metadata, and releases.
# ==============================================================================

# ------------------------------------------------------------------------------
# Build, Install & Staging Directories
# ------------------------------------------------------------------------------
build/
build-*/
_build/
cmake-build-*/
out/
dist/
install/
release/
artifacts/
stage/

# ------------------------------------------------------------------------------
# Fortran Compilers, Modules, Preprocessor & Runtime Artifacts
# (gfortran, ifx/ifort, flang/amdflang, nvfortran/pgfortran, nagfor, lfortran, xlf)
# ------------------------------------------------------------------------------
# Compiled module & submodule interface files
*.mod
*.smod
*.mod0
*.rmod
*__genmod.f90
*__genmod.mod

# Object files
*.o
*.obj
*.lo
*.ko
*.elf

# Static & shared libraries / import libs
*.a
*.la
*.lai
*.lib
*.so
*.so.*
*.dylib
*.dll
*.def
*.exp
*.ilk

# Executables & debug symbol bundles
*.exe
*.out
*.app
*.pdb
*.idb
*.dSYM/
/cdd-fortran

# Preprocessed Fortran, assembly, IR & compiler optimization reports
*.i
*.i90
*.lst
*.optrpt
*.su
*.s
*.S
*.bc
*.ll

# Unconnected Fortran scratch/unit files & crash dumps
fort.[0-9]*
core
!/src/core/
core.*
vgcore.*

# ------------------------------------------------------------------------------
# Fortran Package Manager (fpm)
# ------------------------------------------------------------------------------
.fpm/
fpm-scratch/

